{
  "name": "luz-crawl-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for LuzCrawl with a persistent browser and manual verification",
  "scripts": {
    "start": "node --max-old-space-size=256 server.mjs",
    "test": "node --max-old-space-size=256 --test --test-concurrency=1 --test-timeout=20000 test/*.test.mjs"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.1.0",
    "playwright": "1.64.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
